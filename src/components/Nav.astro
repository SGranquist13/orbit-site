---
import { Image } from "astro:assets";
import mark from "../assets/brand/app-icon-desktop.png";
import Button from "./Button.astro";
import GithubMark from "./GithubMark.astro";
import { GITHUB_URL } from "../config";
import { asset } from "../lib/url";

const home = asset("");
const onHome = Astro.url.pathname.replace(/\/$/, "") === home.replace(/\/$/, "");
const links = [
  { href: onHome ? "#features" : `${home}#features`, label: "Product" },
  { href: onHome ? "#review" : `${home}#review`, label: "Review" },
  { href: onHome ? "#ide" : `${home}#ide`, label: "IDE" },
  { href: onHome ? "#mobile" : `${home}#mobile`, label: "Mobile" },
  { href: asset("features/"), label: "Features" },
];
---

<header data-nav class="nav">
  <div class="container-wide bar">
    <a href={onHome ? "#top" : home} class="brand" aria-label="Orbit home">
      <Image src={mark} alt="" width={28} height={28} densities={[1, 2]} format="png" class="mark" />
      <span>orbit</span>
    </a>
    <nav class="links" aria-label="Primary" data-nav-links>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <span class="nav-ind" data-nav-ind aria-hidden="true"></span>
    </nav>
    <Button href={GITHUB_URL} variant="secondary" size="sm" aria-label="Orbit on GitHub">
      <GithubMark size={15} />
      <span>GitHub</span>
    </Button>
  </div>
  <div class="dither-rule rule"></div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50; height: 64px;
    transition: background-color .25s, backdrop-filter .25s;
  }
  .nav[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  }
  .rule { position: absolute; bottom: 0; left: 0; opacity: 0; transition: opacity .25s; }
  .nav[data-scrolled] .rule { opacity: 1; }
  .bar { height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--fg); font-weight: 600; font-size: 20px; letter-spacing: -0.03em; }
  .brand :global(.mark) { width: 28px; height: 28px; border-radius: 6px; mix-blend-mode: lighten; }
  .links { position: relative; display: flex; gap: 32px; margin-left: auto; margin-right: 32px; }
  .links a { font-size: 14px; font-weight: 450; color: var(--dim); transition: color .15s; }
  .links a:hover, .links a[data-current] { color: var(--fg); }
  /* One underline shared by all links; motion.ts moves it to the section in view. */
  .nav-ind {
    position: absolute; left: 0; bottom: -8px; width: 0; height: 1px; background: var(--fg); opacity: 0;
    pointer-events: none; transition: transform .35s cubic-bezier(.22, 1, .36, 1), opacity .25s;
  }
  @media (prefers-reduced-motion: reduce) { .nav-ind { transition: none; } }
  @media (max-width: 767px) { .links { display: none; } }
</style>

