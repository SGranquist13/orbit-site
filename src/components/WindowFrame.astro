---
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { asset } from "../lib/url";

/** Desktop product frame: 1px line-strong border, 14px radius, --pop shadow. Image or looping video. */
interface Props {
  /** Still image, optimised to AVIF/WebP at 1280/1920/2560. */
  image?: ImageMetadata;
  /** Video basename under public/media (without extension), played from webm then mp4. */
  video?: string;
  /** Poster image for the video. */
  poster?: ImageMetadata;
  /** Or a ready poster URL under public/ (e.g. media/x.jpg). */
  posterSrc?: string;
  alt?: string;
  eager?: boolean;
  preload?: "none" | "metadata";
  class?: string;
  [key: string]: unknown;
}
const { image, video, poster, posterSrc, alt = "", eager = false, preload = "none", class: className = "", ...rest } = Astro.props;
const posterUrl = posterSrc ? asset(posterSrc) : poster ? (await getImage({ src: poster, format: "webp", width: 1920 })).src : undefined;
---

<div class:list={["window-frame", className]} {...rest}>
  {
    video ? (
      <video
        data-lazy-video
        muted
        loop
        playsinline
        preload={preload}
        poster={posterUrl}
        aria-label={alt || undefined}
        aria-hidden={alt ? undefined : "true"}
        width="1920"
        height="1200"
      >
        <source src={asset(`media/${video}.webm`)} type="video/webm" />
        <source src={asset(`media/${video}.mp4`)} type="video/mp4" />
      </video>
    ) : image ? (
      <Picture
        src={image}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[1280, 1920, 2560]}
        sizes="(min-width: 1344px) 1320px, 100vw"
        loading={eager ? "eager" : "lazy"}
      />
    ) : (
      <slot />
    )
  }
</div>

<style>
  .window-frame {
    position: relative; overflow: hidden; border-radius: var(--r-card); border: 1px solid var(--line-strong);
    background: var(--bg); box-shadow: var(--pop); aspect-ratio: 16 / 10;
  }
  .window-frame :global(video),
  .window-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
</style>
