---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import GithubMark from "../components/GithubMark.astro";
import DitherField from "../components/DitherField.astro";
import DitherReveal from "../components/DitherReveal.astro";
import OrbitArt from "../components/OrbitArt.astro";
import WindowFrame from "../components/WindowFrame.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Kbd from "../components/Kbd.astro";
import Footer from "../components/Footer.astro";
import Marquee from "../components/Marquee.astro";
import { UPDATES_URL } from "../config";
import { asset } from "../lib/url";
import { chapters, featureCount } from "../data/features";

// Every capture in src/assets/raw (kept in sync with the manifest by scripts/sync-media.mjs).
const raw = import.meta.glob<{ default: ImageMetadata }>("../assets/raw/*.png", { eager: true });
const shot = (name: string): ImageMetadata => {
  const m = raw[`../assets/raw/${name}`];
  if (!m) throw new Error(`Missing capture: ${name}. Run node scripts/sync-media.mjs`);
  return m.default;
};
const workspace = shot("orbit-dark-workspace.png");
const mobileWorkspace = shot("mobile-workspace.png");
const mobileWorkspaces = shot("mobile-workspaces.png");
const mobileInbox = shot("mobile-inbox.png");
const mobileActivity = shot("mobile-activity.png");
const mobileDiff = shot("mobile-diff.png");

const statement =
  "Agents are fast. Waiting on them isn't. Orbit runs every task in its own worktree and tells you the moment one needs you: a question, a failed check, a finished pull request.";
const words = statement.split(" ");

const features = [
  {
    title: "One task, one worktree.",
    body: "Start a workspace and Orbit cuts a fresh branch and worktree for it. Claude Code and Codex run side by side in their own checkouts, with live diff stats in the sidebar.",
    kbd: ["Ctrl N"],
    img: workspace,
    alt: "Orbit workspace with the fleet listed in the sidebar and live diff stats.",
  },
  {
    title: "Watch it write.",
    body: "Open Code view on any workspace and the editor follows the agent. New files type in as they are written and each edit flashes. An Activity timeline diffs every turn.",
    kbd: ["Alt 2"],
    img: shot("orbit-dark-code-watch.png"),
    alt: "Orbit Code view following an agent, with flashed edits and the Activity timeline.",
  },
  {
    title: "Only what needs you.",
    body: "The inbox collects every agent that asked a question, failed, or finished, plus any pull request with red checks. Suggested replies are one keystroke away.",
    kbd: ["Alt 1", "J", "K", "E", "S"],
    img: shot("orbit-dark-inbox.png"),
    alt: "Orbit inbox listing agents that asked, failed, or finished.",
  },
  {
    title: "A team, not a prompt.",
    body: "Hand a task to a teammate and get a report back. Chief splits a vague request into parts for Builder, Debugger and Reviewer, and nothing starts until you press Start all. Read-only roles like Planner and Reviewer are blocked from writing at the tool layer.",
    kbd: ["Alt 4"],
    img: shot("orbit-dark-teammates-chief.png"),
    alt: "Orbit Teammates view with Chief's plan card splitting a request into parts.",
  },
  {
    title: "From fix to merge in one panel.",
    body: "Ship shows the draft PR, check status, review state, and every changed file. Fix CI and Address comments hand the failure straight back to the agent.",
    kbd: ["Ctrl Shift G"],
    img: shot("orbit-dark-ship.png"),
    alt: "Orbit Ship panel with the draft pull request, checks and changed files.",
  },
  {
    title: "Work that runs while you sleep.",
    body: "Routines send a message on a schedule: triage at nine, checks at two, a sweep of stale branches on Fridays. Runs with nothing to do archive themselves.",
    kbd: ["Alt 3"],
    img: shot("orbit-dark-routine-editor.png"),
    alt: "Orbit routine editor with a prompt, schedule and templates.",
  },
  {
    title: "Simpler code, same behaviour.",
    body: "Simplify reads what changed, lists what could be simpler, and applies one candidate at a time. Each one is checked and committed as a refactor, or put back.",
    kbd: [] as string[],
    img: shot("orbit-dark-simplify-applying.png"),
    alt: "Orbit Simplify panel applying refactor candidates one at a time.",
  },
];
const total = String(features.length).padStart(2, "0");

const steps = [
  { title: "Add a repo.", line: "Point Orbit at any git repository on your machine." },
  { title: "Start workspaces.", line: "Each one is a branch, a worktree, and an agent. Run as many as you like." },
  { title: "Review and ship.", line: "Answer from the inbox, open a PR from Ship, or do it all from your phone." },
];

// "Why Orbit": the usual way vs Orbit. Every Orbit claim maps to a built feature in src/data/features.ts.
const why = [
  { label: "RUNNING TEN", before: "Ten terminal tabs, and ten branches to keep in your head.", orbit: "Ten workspaces in one sidebar, each in its own worktree, with live status and diff stats." },
  { label: "KNOWING WHEN", before: "You check every tab to find the one that's stuck.", orbit: "The inbox lists only what needs you, with a suggested reply one keystroke away." },
  { label: "SHIPPING", before: "The agent stops at a diff. The PR, the CI and the merge are on you.", orbit: "Ship opens the PR, Fix CI chases red checks, and merge waits for green." },
  { label: "STAYING CLEAN", before: "Branches drift, collide and pile up.", orbit: "Save points, auto-sync onto main, overlap warnings, and cleanup after merge." },
  { label: "READING THE CODE", before: "The diff lands in a chat bubble, and you open another editor to read it.", orbit: "Watch the diff land in a real editor as the agent writes, with a timeline of every turn." },
  { label: "GUARDRAILS", before: "“Please don't edit anything,” written in the prompt.", orbit: "Read-only roles, blocked at the tool layer." },
  { label: "AWAY FROM THE DESK", before: "Work stalls the moment you walk away.", orbit: "Answer, steer or stop any agent from your phone, end-to-end encrypted." },
  { label: "YOUR STACK", before: "Another app, with its own account, its own model and its own bill.", orbit: "Your own Claude Code and Codex, on your machine and your accounts." },
];

// FAQ: only answers we can stand behind today.
const faq = [
  { q: "Does my code leave my machine?", a: "Orbit itself doesn't upload it anywhere. Your agents talk to their own providers exactly as they do in a terminal, and pull requests go to GitHub through your own gh sign-in." },
  { q: "Do I need a new subscription?", a: "No. Orbit runs the Claude Code and Codex CLIs you already have, on your existing accounts." },
  { q: "Do I still need VS Code?", a: "Orbit has an editor, terminal, project search and diffs built in, with VS Code keybindings, so you can read and change what the agent wrote without leaving. There is also Open in Code. Keep your own editor for anything else." },
  { q: "What are teammates?", a: "Named agents with a role, a memory and a thread. You hand them tasks, they open workspaces and draft pull requests, and they report back. For a bigger request, Chief splits it into parts for the others." },
  { q: "Which agents does it support?", a: "Claude Code and Codex, side by side. Background tasks like inbox suggestions can also run on a local model through Ollama or any OpenAI-compatible server." },
  { q: "How does the phone connect?", a: "Scan a QR code in Orbit's settings. After the pairing handshake every message is end-to-end encrypted, over your local network or Tailscale." },
  { q: "What platforms does it run on?", a: "Orbit is built and tested on Windows today, with Orbit Mobile on iPhone. Follow launch updates for other platforms." },
  { q: "When can I use it?", a: "Orbit is in development. Follow launch updates on GitHub to hear when the desktop and mobile repos open." },
];

const ideShot = shot("orbit-dark-code-terminal.png");
const ideFacts = [
  { label: "WATCH MODE", line: "The editor follows the agent from file to file and flashes every edit as it lands." },
  { label: "TERMINAL", line: "Real shells in tabs, opened in the workspace's worktree." },
  { label: "SEARCH AND DIFFS", line: "Project search, a git gutter, and a diff for every agent turn." },
];

const facts = [
  { label: "ENCRYPTED", line: "End-to-end encrypted after the pairing handshake." },
  { label: "LIVE", line: "Transcripts stream as the agent works." },
  { label: "IN CONTROL", line: "Send a message or stop a turn from your phone." },
];

// "Everything in Orbit": crop geometry. The box aspect follows the crop; the image is scaled to fill it.
const SRC = { w: 2560, h: 1600 };
const PHONE = { w: 1170, h: 2532 };
const chapterMedia = chapters.map((c) => {
  const [l, t, w, h] = c.media.crop ?? [0, 0, 100, 100];
  return {
    ...c,
    img: shot(c.media.shot),
    phoneImg: c.media.phone ? shot(c.media.phone) : undefined,
    aspect: (w * SRC.w) / (h * SRC.h),
    imgWidthPct: 10000 / w,
    left: (l / w) * 100,
    top: (t / h) * 100,
    cropW: w,
  };
});
const areas = chapters.length;
// The "See every feature" cell fills whatever the last row of the grid leaves empty.
const ctaSpan = (cols: number) => cols - (areas % cols) || cols;
const apps = 2;
void PHONE;
const stats = [
  { n: featureCount, label: "FEATURES" },
  { n: areas, label: "AREAS" },
  { n: apps, label: "APPS (DESKTOP + IPHONE)" },
];
const keyLabel = (k: string[]) => k.join(" ");
---

<Layout>
  <Nav />
  <main id="top">
    <!-- HERO -->
    <section id="hero" class="hero">
      <div class="container hero-copy">
        <Eyebrow data-hero-in>ORBIT 0.1 — DESKTOP + IPHONE</Eyebrow>
        <h1 class="display h1">
          <span data-hero-in class="line">Run a fleet of coding agents.</span>
          <span data-hero-in class="line mute">Ship from anywhere.</span>
        </h1>
        <p class="lead" data-hero-in>
          Orbit is a desktop IDE for Claude Code and Codex, with a real editor and terminal built in. Every task gets its own worktree, branch, and agent, so ten things can move at once without stepping on each other.
        </p>
        <div class="ctas" data-hero-in>
          <Button href={UPDATES_URL}>
            <GithubMark size={18} />
            Follow launch updates
          </Button>
          <Button href="#features" variant="secondary">
            <svg width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M0 0l10 6-10 6z"></path></svg>
            Watch the tour
          </Button>
        </div>
      </div>

      <div class="stage">
        <div class="field-wrap" data-parallax="0.5" aria-hidden="true">
          <DitherField cell={3} strength={0.7} power={1.5} />
        </div>
        <div class="art">
          <DitherReveal trigger="load" delay={0.25} cell={4}>
            <OrbitArt size="var(--art)" />
          </DitherReveal>
        </div>
        <div class="container-wide window-wrap">
          <div class="window-stage">
            <WindowFrame
              data-hero-window
              video="orbit-tour-dark"
              posterSrc="media/orbit-tour-dark-poster.jpg"
              preload="metadata"
              alt="Orbit workspace: a Claude Code agent fixing a crash in its own worktree, with the fleet listed in the sidebar."
            />
            <div class="hero-phone">
              <div data-hero-phone>
                <PhoneFrame video="mobile-tour" poster={mobileWorkspace} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURE MARQUEE -->
    <Marquee />

    <!-- FEATURES: pinned story -->
    <section id="features" class="section features" data-features>
      <div class="feat-pin" data-feat-pin>
        <div class="container-wide feat-grid">
          <div class="feat-left">
            <Eyebrow>PRODUCT</Eyebrow>
            <h2 class="h2 feat-h2">One window for the whole fleet. <span class="mute">Start it, steer it, ship it.</span></h2>
            <ol class="feat-list">
              {
                features.map((f, i) => (
                  <li class="item" data-feat-item data-active={i === 0 ? "" : undefined}>
                    <button type="button" class="item-head" data-feat-head>
                      <span class="idx">{String(i + 1).padStart(2, "0")}</span>
                      <span class="title">{f.title}</span>
                    </button>
                    <div class="item-body">
                      <div class="item-inner">
                        <p class="body">{f.body}</p>
                        <div class="kbds"><Kbd keys={f.kbd} /></div>
                        <div class="item-media">
                          <WindowFrame image={f.img} alt={f.alt} />
                        </div>
                      </div>
                    </div>
                  </li>
                ))
              }
            </ol>
            <div class="counter" aria-hidden="true"><span data-feat-count>01</span> / {total}</div>
          </div>
          <div class="feat-right">
            <div class="feat-field" aria-hidden="true"><DitherField cell={3} strength={0.5} power={1.4} /></div>
            <WindowFrame class="feat-window" alt="">
              {
                features.map((m, k) => (
                  <div class="slide" data-feat-slide data-active={k === 0 ? "" : undefined}>
                    <Picture src={m.img} alt={m.alt} formats={["avif", "webp"]} widths={[1280, 1920, 2560]} sizes="(min-width: 1344px) 700px, 60vw" loading="lazy" />
                  </div>
                ))
              }
            </WindowFrame>
          </div>
        </div>
      </div>
    </section>

    <!-- IDE: the built-in editor and terminal -->
    <section id="ide" class="section ide">
      <div class="container mobile-head">
        <Eyebrow>CODE VIEW</Eyebrow>
        <h2 class="h2">A full IDE, built in. <span class="mute">Terminal included.</span></h2>
        <p class="lead">
          Open any repo or worktree in an editor with VS Code keybindings, a file explorer, project search and integrated terminals. Watch the agent edit in real time, then take over without switching apps.
        </p>
      </div>
      <div class="container-wide ide-window">
        <DitherReveal cell={4}>
          <WindowFrame image={ideShot} alt="Orbit's Code view: file explorer, an editor with the agent's changes marked in the gutter, a terminal panel, and the agent's activity timeline." />
        </DitherReveal>
        <ul class="facts">
          {
            ideFacts.map((f) => (
              <li class="fact">
                <div class="dither-rule"></div>
                <Eyebrow class="fact-label">{f.label}</Eyebrow>
                <p>{f.line}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- WHY ORBIT -->
    <section id="why" class="section why" data-why>
      <div class="container">
        <Eyebrow>WHY ORBIT</Eyebrow>
        <h2 class="h2 sec-h2">Most tools help agents write code.<br /> <span class="mute">Orbit gets it shipped.</span></h2>
        <div class="why-table" role="table" aria-label="The usual way compared with Orbit">
          <div class="why-row why-head" role="row">
            <span role="columnheader"><span class="sr-only">Area</span></span>
            <span class="eyebrow" role="columnheader">The usual way</span>
            <span class="eyebrow why-orbit-head" role="columnheader">Orbit</span>
          </div>
          {
            why.map((r) => (
              <div class="why-row" role="row" data-why-row>
                <span class="why-label eyebrow" role="rowheader">{r.label}</span>
                <p class="why-before" role="cell"><i class="why-px px-before" aria-hidden="true"></i>{r.before}</p>
                <p class="why-after" role="cell"><i class="why-px px-after" aria-hidden="true"></i>{r.orbit}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- MOBILE -->
    <section id="mobile" class="section mobile">
      <div class="container mobile-head">
        <Eyebrow>ORBIT MOBILE</Eyebrow>
        <h2 class="h2">Leave the desk. <span class="mute">Keep the fleet moving.</span></h2>
        <p class="lead">
          Pair your iPhone by scanning a QR code in Orbit. Read transcripts, review diffs, answer questions, and stop a runaway turn, over your local network or Tailscale.
        </p>
      </div>
      <div class="container-wide">
        <div class="fan" data-fan>
          <DitherReveal class="fan-phone fan-outer fan-outer-left" cell={4} delay={0.2}><PhoneFrame image={mobileWorkspaces} alt="Orbit Mobile workspaces dashboard." /></DitherReveal>
          <DitherReveal class="fan-phone fan-outer fan-outer-right" cell={4} delay={0.2}><PhoneFrame image={mobileActivity} alt="Orbit Mobile activity timeline." /></DitherReveal>
          <DitherReveal class="fan-phone fan-left" cell={4} delay={0.1}><PhoneFrame image={mobileInbox} alt="Orbit Mobile inbox." /></DitherReveal>
          <DitherReveal class="fan-phone fan-right" cell={4} delay={0.1}><PhoneFrame image={mobileDiff} alt="Orbit Mobile diff review." /></DitherReveal>
          <DitherReveal class="fan-phone fan-center" cell={4}><PhoneFrame video="mobile-tour" poster={mobileWorkspace} /></DitherReveal>
        </div>
        <p class="fan-hint eyebrow" aria-hidden="true">Swipe for more screens</p>
        <ul class="facts">
          {
            facts.map((f) => (
              <li class="fact">
                <div class="dither-rule"></div>
                <Eyebrow class="fact-label">{f.label}</Eyebrow>
                <p>{f.line}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- AREAS: compact index of everything; the full list is on /features -->
    <section id="areas" class="section areas">
      <div class="container">
        <Eyebrow>EVERYTHING IN ORBIT</Eyebrow>
        <h2 class="h2 sec-h2">{featureCount} features, already built.<br /> <span class="mute">Here's where they live.</span></h2>
        <ol class="area-grid">
          {
            chapters.map((c, i) => (
              <li>
                <a class="area" href={asset(`features/#ch-${c.id}`)}>
                  <span class="area-top"><span class="area-n">{String(i + 1).padStart(2, "0")}</span><span class="area-count">{c.features.length}</span></span>
                  <span class="area-title">{c.title}</span>
                  <span class="area-lead">{c.lead}</span>
                </a>
              </li>
            ))
          }
          <li class="area-cta-cell" style={`--span-2: ${ctaSpan(2)}; --span-4: ${ctaSpan(4)}`}>
            <a class="area area-cta" href={asset("features/")}>
              <span class="area-title">See every feature <span aria-hidden="true">→</span></span>
              <span class="area-lead">All {featureCount}, with screenshots and shortcuts.</span>
            </a>
          </li>
        </ol>
      </div>
    </section>

    <!-- YOUR MACHINE + FAQ -->
    <section id="faq" class="section faq">
      <div class="container faq-grid">
        <div class="faq-intro">
          <Eyebrow>YOUR MACHINE, YOUR ACCOUNTS</Eyebrow>
          <h2 class="h2 sec-h2">Nothing in between.</h2>
          <p class="lead">Orbit drives the Claude Code and Codex you already use. Worktrees live on your disk, state lives in your home folder, and your phone talks to your desktop directly.</p>
        </div>
        <div class="faq-list">
          {
            faq.map((q) => (
              <details class="faq-item">
                <summary><span>{q.q}</span><i class="faq-px" aria-hidden="true"></i></summary>
                <p>{q.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="cta" class="cta">
      <div class="cta-horizon" aria-hidden="true">
        <DitherReveal cell={4} class="cta-reveal">
          <DitherField variant="horizon" hi="dim" cell={3} strength={0.9} />
        </DitherReveal>
      </div>
      <div class="container cta-inner">
        <div class="cta-art">
          <div class="field-wrap" aria-hidden="true">
            <DitherField cell={3} strength={0.7} power={1.5} />
          </div>
          <div class="art">
            <DitherReveal cell={4} class="cta-orbit"><OrbitArt size="var(--art)" /></DitherReveal>
          </div>
        </div>
        <h2 class="h2">Run your next ten tasks in parallel.</h2>
        <p class="lead">Orbit is in development. Desktop and mobile open-source repos coming soon. Follow launch updates and share what you want to build.</p>
        <div class="ctas">
          <Button href={UPDATES_URL}><GithubMark size={18} />Follow launch updates</Button>
          <Button href="#mobile" variant="secondary">Explore Orbit Mobile</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero { --art: min(520px, 78vw); position: relative; overflow: clip; padding-top: calc(64px + 80px); padding-bottom: 96px; }
  .hero-copy { display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; z-index: 10; }
  .h1 { margin-top: 24px; }
  .h1 .line { display: block; }
  .hero-copy .lead { margin-top: 24px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 36px; }

  .stage { position: relative; margin-top: 16px; }
  /* Radial glow centred on the black hole (0.475 of the art), starting 40px below the CTAs. */
  .field-wrap {
    --fw: min(1100px, 150vw);
    position: absolute; z-index: 0; top: 24px; width: var(--fw); height: calc(var(--art) * 0.95 - 48px);
    left: calc(50% - var(--fw) / 2); pointer-events: none;
  }
  .art { position: relative; display: flex; justify-content: center; height: var(--art); pointer-events: none; }
  .window-wrap { position: relative; z-index: 10; margin-top: calc(var(--art) * -0.42); }
  @media (max-width: 639px) { .window-wrap { margin-top: calc(var(--art) * -0.5); } }
  .window-stage { position: relative; perspective: 1600px; max-width: var(--container); margin-inline: auto; }
  .window-stage :global([data-hero-window]) { will-change: transform; }

  /* About 35% of the phone's width sits past the window's right edge, 10% of its height past the bottom. */
  .hero-phone {
    position: absolute; z-index: 11; width: 15%; bottom: 0; transform: translateY(10%);
    left: calc(100% - 15% * 0.65);
  }
  @media (max-width: 1339px) { .hero-phone { left: calc(85% + var(--gutter) * 0.9); } }
  @media (max-width: 1023px) { .hero-phone { display: none; } }

  /* ---------- Statement ---------- */
  .statement { padding-top: 64px; }
  .statement-text {
    max-width: min(1120px, 70vw); margin: 0; font-size: clamp(28px, 3.6vw, var(--statement-max, 48px)); font-weight: 540;
    letter-spacing: -0.03em; line-height: 1.18; color: var(--fg); text-wrap: pretty;
  }

  /* ---------- Features (mobile-first: stacked) ---------- */
  .features { overflow-x: clip; padding-top: 64px; }
  .feat-grid { display: block; }
  .feat-h2 { margin-top: 20px; font-size: clamp(34px, 3.4vw, 46px); }
  .feat-h2 > span { display: block; text-wrap: balance; }
  /* Headline line masks (built by motion.ts). */
  :global(.h2 .hl) { display: block; overflow: hidden; padding-bottom: 0.12em; margin-bottom: -0.12em; }
  :global(.h2 .hl-in) { display: block; }
  .feat-list { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 56px; }
  .item-head {
    display: flex; align-items: baseline; gap: 16px; width: 100%; padding: 0; margin: 0; background: none; border: 0;
    text-align: left; color: var(--fg); font: inherit; pointer-events: none;
  }
  .idx { font: 500 12px/1 var(--font-mono); letter-spacing: 0.08em; color: var(--mute); width: 24px; flex: none; }
  .title { font-size: 22px; font-weight: 520; letter-spacing: -0.015em; line-height: 1.25; }
  .item-body { display: block; }
  .item-inner { padding-top: 14px; }
  .body { margin: 0; color: var(--dim); max-width: 520px; text-wrap: pretty; }
  .kbds { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .item-media { display: grid; gap: 16px; margin-top: 24px; }
  .feat-right, .counter { display: none; }

  @media (min-width: 1024px) {
    .features { padding-top: 0; }
    .feat-pin { height: 100vh; min-height: 720px; display: flex; align-items: center; padding-top: 64px; }
    .feat-grid { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; align-items: center; }
    .feat-left { grid-column: 1 / span 5; padding-right: 16px; }
    .feat-right { display: block; grid-column: 6 / span 7; position: relative; }
    .feat-list { gap: 0; margin-top: 32px; }
    .item { position: relative; padding-left: 20px; }
    .item::before, .item::after { content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 2px; }
