---
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { asset } from "../lib/url";

/** CSS iPhone: 44px outer radius, 10px #0b0b0d bezel, 1px line-strong outline, dynamic island. */
interface Props {
  image?: ImageMetadata;
  video?: string;
  poster?: ImageMetadata;
  alt?: string;
  class?: string;
  [key: string]: unknown;
}
const { image, video, poster, alt = "", class: className = "", ...rest } = Astro.props;
const posterUrl = poster ? (await getImage({ src: poster, format: "webp", width: 780 })).src : undefined;
---

<div class:list={["phone", className]} {...rest}>
  <div class="screen">
    {
      video ? (
        <video data-lazy-video muted loop playsinline preload="none" poster={posterUrl} aria-hidden="true" width="780" height="1688">
          <source src={asset(`media/${video}.webm`)} type="video/webm" />
          <source src={asset(`media/${video}.mp4`)} type="video/mp4" />
        </video>
      ) : image ? (
        <Picture src={image} alt={alt} formats={["avif", "webp"]} widths={[390, 780, 1170]} sizes="320px" loading="lazy" />
      ) : null
    }
    <span class="island"></span>
  </div>
</div>

<style>
  .phone {
    container-type: inline-size; width: 100%; padding: 10px; background: var(--panel);
    border-radius: var(--r-phone); box-shadow: var(--pop);
  }
  .screen {
    position: relative; overflow: hidden; aspect-ratio: 1170 / 2532; background: var(--bg);
    border-radius: calc(var(--r-phone) - 10px);
  }
  /* The captures have no status bar, so the screen content starts below the island. */
  .screen :global(picture), .screen :global(video) { position: absolute; top: 10.6cqw; left: 0; width: 100%; height: auto; }
  .screen :global(img) { width: 100%; height: auto; }
  .island {
    position: absolute; top: 2.6cqw; left: 50%; width: 26cqw; height: 6.6cqw; transform: translateX(-50%);
    background: #000; border-radius: 9999px;
  }
</style>
