---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import GithubMark from "../components/GithubMark.astro";
import DitherField from "../components/DitherField.astro";
import DitherReveal from "../components/DitherReveal.astro";
import OrbitArt from "../components/OrbitArt.astro";
import WindowFrame from "../components/WindowFrame.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Kbd from "../components/Kbd.astro";
import Footer from "../components/Footer.astro";
import Marquee from "../components/Marquee.astro";
import { GITHUB_URL, VERSION } from "../config";
import { asset } from "../lib/url";
import { chapters, featureCount, areaCount, releasedIn, soonCount, previewCount } from "../data/features";
import { story } from "../data/story";
import { shot } from "../lib/shots";

const workspace = shot("orbit-dark-workspace.png");
const mobileWorkspace = shot("mobile-workspace.png");
const mobileWorkspaces = shot("mobile-workspaces.png");
const mobileInbox = shot("mobile-inbox.png");
const mobileActivity = shot("mobile-activity.png");
const mobileDiff = shot("mobile-diff.png");

const statement =
  "Agents are fast. Waiting on them isn't. Orbit runs every task in its own worktree and tells you the moment one needs you: a question, a failed check, a finished pull request.";
const words = statement.split(" ");

const features = story.map((f) => ({ ...f, img: shot(f.shot) }));
const total = String(features.length).padStart(2, "0");

const steps = [
  { title: "Add a repo.", line: "Point Orbit at any git repository on your machine." },
  { title: "Start workspaces.", line: "Each one is a branch, a worktree, and an agent. Run as many as you like." },
  { title: "Review and ship.", line: "Answer from the inbox, open a PR from Ship, or do it all from your phone." },
];

// "Why Orbit": the usual way vs Orbit. Every Orbit claim maps to a built feature in src/data/features.ts.
const why = [
  { label: "RUNNING TEN", before: "Ten terminal tabs, and ten branches to keep in your head.", orbit: "Ten workspaces in one sidebar, each in its own worktree, with live status and diff stats." },
  { label: "KNOWING WHEN", before: "You check every tab to find the one that's stuck.", orbit: "The inbox lists only what needs you, with a suggested reply one keystroke away." },
  { label: "SHIPPING", before: "The agent stops at a diff. The PR, the CI and the merge are on you.", orbit: "Ship opens the PR, Fix CI chases red checks, and merge waits for green." },
  { label: "STAYING CLEAN", before: "Branches drift, collide and pile up.", orbit: "Save points, auto-sync onto main, overlap warnings, and cleanup after merge." },
  { label: "GUARDRAILS", before: "“Please don't edit anything,” written in the prompt.", orbit: "Read-only roles, blocked at the tool layer." },
  { label: "AWAY FROM THE DESK", before: "Work stalls the moment you walk away.", orbit: "Answer, steer or stop any agent from your phone, end-to-end encrypted." },
  { label: "YOUR STACK", before: "Another app, with its own account, its own model and its own bill.", orbit: "Your own Claude Code and Codex, on your machine and your accounts." },
];

const facts = [
  { label: "ENCRYPTED", line: "End-to-end encrypted after the pairing handshake." },
  { label: "LIVE", line: "Transcripts stream as the agent works." },
  { label: "IN CONTROL", line: "Send a message or stop a turn from your phone." },
];

// "Everything in Orbit": crop geometry. The box aspect follows the crop; the image is scaled to fill it.
const SRC = { w: 2560, h: 1600 };
const PHONE = { w: 1170, h: 2532 };
const chapterMedia = chapters.map((c) => {
  const [l, t, w, h] = c.media.crop ?? [0, 0, 100, 100];
  return {
    ...c,
    img: shot(c.media.shot),
    phoneImg: c.media.phone ? shot(c.media.phone) : undefined,
    aspect: (w * SRC.w) / (h * SRC.h),
    imgWidthPct: 10000 / w,
    left: (l / w) * 100,
    top: (t / h) * 100,
    cropW: w,
  };
});
const areas = areaCount;
const apps = 2;
void PHONE;
const stats = [
  { n: featureCount, label: "FEATURES" },
  { n: areas, label: "AREAS" },
  { n: apps, label: "APPS (DESKTOP + IPHONE)" },
];
const keyLabel = (k: string[]) => k.join(" ");
---

<Layout title="Every feature — Orbit" description={`Every feature in Orbit ${VERSION} and Orbit Mobile: the built-in IDE, agents, review, shipping and routines, with Preview and Coming soon features marked.`}>
  <Nav />
  <main id="top">
    <!-- EVERYTHING IN ORBIT -->
    <section id="everything" class="section everything" data-everything>
      <div class="container">
        <Eyebrow>EVERYTHING IN ORBIT</Eyebrow>
        <h1 class="h2 sec-h2">Every feature, already built.<br /> <span class="mute">Here's the whole list.</span></h1>
        <dl class="stats" data-stats>
          {
            stats.map((s) => (
              <div class="stat">
                <dt class="eyebrow stat-label">{s.label}</dt>
                <dd class="stat-num" data-count={s.n}>{s.n}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="container ev-wrap">
        <!-- Mobile and tablet: sticky chip bar -->
        <nav class="chips" data-chips aria-label="Chapters">
          <div class="chips-track" data-chips-track>
            {
              chapterMedia.map((c, i) => (
                <a class="chip" href={`#ch-${c.id}`} data-chip={c.id} data-active={i === 0 ? "" : undefined}>{c.title}</a>
              ))
            }
          </div>
        </nav>

        <div class="ev-grid">
          <!-- Desktop: sticky chapter index -->
          <aside class="index" aria-label="Chapters">
            <div class="index-inner">
              <div class="index-progress" aria-hidden="true"><span data-index-fill></span></div>
              <ol>
                {
                  chapterMedia.map((c, i) => (
                    <li>
                      <a class="index-row" href={`#ch-${c.id}`} data-index={c.id} data-active={i === 0 ? "" : undefined}>
                        <span class="index-title">{c.title}</span>
                        {releasedIn(c) === 0 && <span class="index-count">Soon</span>}
                      </a>
                    </li>
                  ))
                }
              </ol>
            </div>
          </aside>

          <div class="chapters">
            {
              chapterMedia.map((c, i) => (
                <article class="chapter" id={`ch-${c.id}`} data-chapter={c.id}>
                  <header class="ch-head">
                    <div class="ch-title-row">
                      <h3 class="ch-title">{c.title}</h3>
                    </div>
                    <p class="ch-lead">{c.lead}</p>
                  </header>

                  {c.phoneImg ? (
                    <div class="ch-phones" role="img" aria-label={c.media.alt}>
                      <DitherReveal class="ch-phone" cell={4}><PhoneFrame image={c.img} alt="" /></DitherReveal>
                      <DitherReveal class="ch-phone" cell={4} delay={0.15}><PhoneFrame image={c.phoneImg} alt="" /></DitherReveal>
                    </div>
                  ) : (
                    <WindowFrame class="ch-frame" style={`aspect-ratio:${c.aspect.toFixed(4)}`}>
                      <div class="ch-crop" data-crop>
                        <Picture
                          src={c.img}
                          alt={c.media.alt}
                          formats={["avif", "webp"]}
                          widths={[1280, 1920, 2560]}
                          sizes={`(min-width: 1024px) ${Math.round(c.imgWidthPct * 0.62)}vw, ${Math.round(c.imgWidthPct)}vw`}
                          loading="lazy"
                          decoding="async"
                          style={`width:${c.imgWidthPct.toFixed(3)}%;left:-${c.left.toFixed(3)}%;top:-${c.top.toFixed(3)}%`}
                        />
                      </div>
                    </WindowFrame>
                  )}

                  <ul class="ch-grid" data-feats>
                    {c.features.map((f) => (
                      <li class="feat">
                        <div class="dither-rule"></div>
                        <div class="feat-title">
                          <h4>{f.title}</h4>
                          {f.tag && <span class="tag" data-soon={f.tag === "Coming soon" ? "" : undefined}>{f.tag}</span>}
                        </div>
                        <p>{f.body}</p>
                        {f.keys && (
                          <div class="feat-keys">
                            {f.keys.map((k) => (
                              <kbd class="kbd">{keyLabel(k)}</kbd>
                            ))}
                          </div>
                        )}
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="cta" class="cta">
      <div class="cta-horizon" aria-hidden="true">
        <DitherReveal cell={4} class="cta-reveal">
          <DitherField variant="horizon" hi="dim" cell={3} strength={0.9} />
        </DitherReveal>
      </div>
      <div class="container cta-inner">
        <div class="cta-art">
          <div class="field-wrap" aria-hidden="true">
            <DitherField cell={3} strength={0.7} power={1.5} />
          </div>
          <div class="art">
            <DitherReveal cell={4} class="cta-orbit"><OrbitArt size="var(--art)" /></DitherReveal>
          </div>
        </div>
        <h2 class="h2">Run your next ten tasks in parallel.</h2>
        <p class="lead">Orbit is open source under the MIT license. Download the Windows installer, or build it from source. Orbit Mobile is still in development.</p>
        <div class="ctas">
          <Button href={GITHUB_URL}><GithubMark size={18} />View on GitHub</Button>
          <Button href={asset("")} variant="secondary">Back to the overview</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero { --art: min(520px, 78vw); position: relative; overflow: clip; padding-top: calc(64px + 80px); padding-bottom: 96px; }
  .hero-copy { display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; z-index: 10; }
  .h1 { margin-top: 24px; }
  .h1 .line { display: block; }
  .hero-copy .lead { margin-top: 24px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 36px; }

  .stage { position: relative; margin-top: 16px; }
  /* Radial glow centred on the black hole (0.475 of the art), starting 40px below the CTAs. */
  .field-wrap {
    --fw: min(1100px, 150vw);
    position: absolute; z-index: 0; top: 24px; width: var(--fw); height: calc(var(--art) * 0.95 - 48px);
    left: calc(50% - var(--fw) / 2); pointer-events: none;
  }
  .art { position: relative; display: flex; justify-content: center; height: var(--art); pointer-events: none; }
  .window-wrap { position: relative; z-index: 10; margin-top: calc(var(--art) * -0.42); }
  @media (max-width: 639px) { .window-wrap { margin-top: calc(var(--art) * -0.5); } }
  .window-stage { position: relative; perspective: 1600px; max-width: var(--container); margin-inline: auto; }
  .window-stage :global([data-hero-window]) { will-change: transform; }

  /* About 35% of the phone's width sits past the window's right edge, 10% of its height past the bottom. */
  .hero-phone {
    position: absolute; z-index: 11; width: 15%; bottom: 0; transform: translateY(10%);
    left: calc(100% - 15% * 0.65);
  }
  @media (max-width: 1339px) { .hero-phone { left: calc(85% + var(--gutter) * 0.9); } }
  @media (max-width: 1023px) { .hero-phone { display: none; } }

  /* ---------- Statement ---------- */
  .statement { padding-top: 64px; }
  .statement-text {
    max-width: min(1120px, 70vw); margin: 0; font-size: clamp(28px, 3.6vw, var(--statement-max, 48px)); font-weight: 540;
    letter-spacing: -0.03em; line-height: 1.18; color: var(--fg); text-wrap: pretty;
  }

  /* ---------- Features (mobile-first: stacked) ---------- */
  .features { overflow-x: clip; padding-top: 64px; }
  .feat-grid { display: block; }
  .feat-h2 { margin-top: 20px; font-size: clamp(34px, 3.4vw, 46px); }
  .feat-h2 > span { display: block; text-wrap: balance; }
  /* Headline line masks (built by motion.ts). */
  :global(.h2 .hl) { display: block; overflow: hidden; padding-bottom: 0.12em; margin-bottom: -0.12em; }
  :global(.h2 .hl-in) { display: block; }
  .feat-list { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 56px; }
  .item-head {
    display: flex; align-items: baseline; gap: 16px; width: 100%; padding: 0; margin: 0; background: none; border: 0;
    text-align: left; color: var(--fg); font: inherit; pointer-events: none;
  }
  .idx { font: 500 12px/1 var(--font-mono); letter-spacing: 0.08em; color: var(--mute); width: 24px; flex: none; }
  .title { font-size: 22px; font-weight: 520; letter-spacing: -0.015em; line-height: 1.25; }
  .item-body { display: block; }
  .item-inner { padding-top: 14px; }
  .body { margin: 0; color: var(--dim); max-width: 520px; text-wrap: pretty; }
  .kbds { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .item-media { display: grid; gap: 16px; margin-top: 24px; }
  .feat-right, .counter { display: none; }

  @media (min-width: 1024px) {
    .features { padding-top: 0; }
    .feat-pin { height: 100vh; min-height: 720px; display: flex; align-items: center; padding-top: 64px; }
    .feat-grid { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; align-items: center; }
    .feat-left { grid-column: 1 / span 5; padding-right: 16px; }
    .feat-right { display: block; grid-column: 6 / span 7; position: relative; }
    .feat-list { gap: 0; margin-top: 32px; }
    .item { position: relative; padding-left: 20px; }
    .item::before, .item::after { content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 2px; }
    .item::before { background: var(--line); }
    .item::after { background: var(--fg); transform: scaleY(0); transform-origin: top; transition: transform .5s cubic-bezier(.22, 1, .36, 1); }
    .item[data-active]::after { transform: scaleY(1); }
    .item-head { padding: 9px 0; cursor: pointer; color: var(--mute); pointer-events: auto; transition: color .3s; }
    .item-head:hover { color: var(--dim); }
    .item[data-active] .item-head { color: var(--fg); }
    .item-body { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows .5s cubic-bezier(.22, 1, .36, 1), opacity .4s; }
    .item[data-active] .item-body { grid-template-rows: 1fr; opacity: 1; }
    .item-inner { overflow: hidden; min-height: 0; padding: 0 0 8px 40px; }
    .item-media { display: none; }
    .counter { display: block; margin-top: 28px; font: 500 12px/1 var(--font-mono); letter-spacing: 0.08em; color: var(--mute); }
    .counter span { color: var(--fg); }

    .feat-field { position: absolute; z-index: 0; width: 124%; height: 150%; left: -12%; top: -25%; pointer-events: none; }
    .feat-right :global(.feat-window) { position: relative; z-index: 1; }
    .slide { position: absolute; inset: 0; opacity: 0; transform: scale(1.02); transition: opacity .7s ease, transform .9s cubic-bezier(.22, 1, .36, 1); }
    .slide[data-active] { opacity: 1; transform: none; }
    .slide :global(img), .slide :global(picture) { width: 100%; height: 100%; display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide, .item::after, .item-body { transition: none; }
  }

  /* ---------- Mobile ---------- */
  .why-table { margin-top: 64px; }
  .why-row { display: grid; grid-template-columns: 1fr; gap: 10px; padding-block: 28px; position: relative; }
  .why-row::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 1px;
    background-image: radial-gradient(circle at 0.5px 0.5px, var(--line-strong) 0.5px, transparent 0.75px); background-size: 4px 1px; background-repeat: repeat-x; }
  .why-head { display: none; }
  .why-label { color: var(--mute); }
  .why-before, .why-after { margin: 0; display: flex; gap: 14px; align-items: baseline; font-size: 16px; line-height: 1.55; }
  .why-before { color: var(--mute); }
  .why-after { color: var(--fg); font-size: 17px; }
  .why-px { flex: none; width: 6px; height: 6px; transform: translateY(-2px); }
  .px-before { background: var(--bad); }
  .px-after { background: var(--ok); }
  @media (min-width: 900px) {
    .why-row { grid-template-columns: 200px 1fr 1.2fr; gap: 40px; align-items: baseline; padding-block: 30px; }
    .why-head { display: grid; padding-block: 0 18px; }
    .why-head::before { display: none; }
    .why-orbit-head { color: var(--fg); }
    .why-after { font-size: 18px; }
  }

  .mobile { overflow-x: clip; }
  .mobile-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .mobile-head .h2 { margin-top: 20px; }
  .mobile-head .lead { margin-top: 20px; }
  .fan { --pw: 260px; position: relative; height: calc((var(--pw) - 20px) * 2.1641 + 20px + 112px); margin-top: 56px; }
  .fan :global(.fan-phone) { position: absolute; top: 48px; left: 50%; width: var(--pw); margin-left: calc(var(--pw) / -2); }
  .fan :global(.fan-left) { transform: translateX(-58%) translateY(12px) rotate(-5deg) scale(0.94); z-index: 2; display: none; }
  .fan :global(.fan-right) { transform: translateX(58%) translateY(12px) rotate(5deg) scale(0.94); z-index: 2; display: none; }
  .fan :global(.fan-outer) { display: none; z-index: 1; filter: brightness(0.6); }
  .fan :global(.fan-outer-left) { transform: translateX(-106%) translateY(40px) rotate(-9deg) scale(0.86); }
  .fan :global(.fan-outer-right) { transform: translateX(106%) translateY(40px) rotate(9deg) scale(0.86); }
  .fan :global(.fan-center) { transform: translateY(-24px); z-index: 3; }
  @media (min-width: 640px) {
    .fan { --pw: clamp(220px, 28vw, 300px); }
    .fan :global(.fan-left), .fan :global(.fan-right) { display: block; }
  }
  @media (min-width: 1100px) {
    .fan { --pw: clamp(210px, 17vw, 250px); }
    .fan :global(.fan-outer) { display: block; }
  }

  .facts { list-style: none; margin: 96px 0 0; padding: 0; display: grid; gap: 40px; }
  .fact :global(.fact-label) { display: block; margin-top: 20px; color: var(--fg); }
  .fact p { margin: 12px 0 0; max-width: 30ch; }
  @media (min-width: 768px) { .facts { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  @media (max-width: 639px) { .facts { margin-top: 64px; } }

  /* ---------- Shared ---------- */
  .sec-h2 { margin-top: 20px; }

  /* ---------- How it works ---------- */
  .steps { list-style: none; margin: 72px 0 0; padding: 0; display: grid; gap: 0; }
  .num-row { display: flex; align-items: center; gap: 24px; }
  .num { font: 500 64px/1 var(--font-mono); letter-spacing: -0.04em; color: var(--fg); will-change: transform; }
  :global(html.js) .num { color: var(--line-strong); }
  .rule {
    flex: 1; height: 1px; margin-right: 24px;
    background-image: radial-gradient(circle at 0.5px 0.5px, var(--line-strong) 0.5px, transparent 0.75px);
    background-size: 4px 1px; background-repeat: repeat-x;
  }
  .step-text { margin-top: 28px; }
  .step-text p { margin: 8px 0 0; max-width: 32ch; }
  @media (min-width: 768px) {
    .steps { grid-template-columns: repeat(3, 1fr); column-gap: 0; }
  }
  @media (max-width: 767px) {
    .steps { margin-top: 56px; }
    .step { display: grid; grid-template-columns: 76px 1fr; column-gap: 20px; padding-bottom: 40px; }
    .step:last-child { padding-bottom: 0; }
    .num-row { flex-direction: column; align-items: flex-start; gap: 12px; }
    .num { font-size: 48px; }
    .rule {
      width: 1px; height: auto; margin: 0 0 0 16px; background-image: radial-gradient(circle at 0.5px 0.5px, var(--line-strong) 0.5px, transparent 0.75px);
      background-size: 1px 4px; background-repeat: repeat-y;
    }
    .step-text { margin-top: 6px; }
  }

  /* ---------- Everything in Orbit ---------- */
  .everything { overflow-x: clip; }
  .stats { display: flex; flex-wrap: wrap; gap: 32px 72px; margin: 64px 0 0; padding: 0; }
  .stat { margin: 0; }
  .stat-label { display: block; margin: 0; order: 2; }
  .stat { display: flex; flex-direction: column-reverse; gap: 14px; }
  .stat-num {
    margin: 0; font: 500 clamp(44px, 6.2vw, 84px)/1 var(--font-mono); letter-spacing: -0.04em; color: var(--fg);
    font-variant-numeric: tabular-nums; will-change: transform;
  }
  .ev-wrap { margin-top: 96px; }
  .ev-grid { display: block; }

  .chips {
    position: sticky; top: 64px; z-index: 40; margin-inline: calc(var(--gutter) * -1); padding: 12px var(--gutter);
    background: color-mix(in srgb, var(--bg) 80%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-bottom: 1px dotted var(--line-strong);
  }
  .chips-track { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .chips-track::-webkit-scrollbar { display: none; }
  .chip {
    flex: none; padding: 8px 14px; border-radius: 9999px; border: 1px solid var(--line-strong); font: 500 13px/1 var(--font-sans);
    color: var(--mute); white-space: nowrap; transition: color .2s, background-color .2s, border-color .2s;
  }
  .chip[data-active] { color: var(--fg); background: var(--raised); border-color: var(--mute); }
  .index { display: none; }

  .chapters { display: grid; gap: 88px; padding-top: 48px; }
  .chapter { scroll-margin-top: 140px; }
  .ch-title-row { display: flex; align-items: baseline; gap: 16px; }
  .ch-idx { font: 500 12px/1 var(--font-mono); letter-spacing: 0.08em; color: var(--mute); }
  .ch-title { margin: 0; font-size: clamp(26px, 2.4vw, 32px); font-weight: 540; letter-spacing: -0.03em; line-height: 1.1; color: var(--fg); }
  .ch-lead { margin: 14px 0 0; font-size: 18px; line-height: 1.5; color: var(--dim); max-width: 600px; text-wrap: pretty; }

  .chapter :global(.ch-frame) { margin-top: 32px; width: 100%; }
  .ch-crop { position: absolute; inset: 0; overflow: hidden; }
  .ch-crop :global(picture) { display: contents; }
  .ch-crop :global(img) { position: absolute; max-width: none; height: auto; }

  .ch-phones { display: flex; justify-content: center; gap: 20px; margin-top: 32px; }
  .ch-phones :global(.ch-phone) { width: min(280px, calc((100% - 20px) / 2)); }

  .ch-grid { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: 1fr; column-gap: 40px; }
  .feat { padding: 0 0 28px; }
  .feat .dither-rule { margin-bottom: 24px; }
  .feat-title { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 10px; }
  .feat h4 { margin: 0; font-size: 16px; font-weight: 540; letter-spacing: -0.01em; line-height: 1.35; color: var(--fg); }
  .tag[data-soon] { border-style: dashed; }
